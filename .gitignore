def compute_meridional_penalty(model_da, obs_lo, obs_hi):
    """
    Penalty sum over longitudes (no weighting) for a model DataArray with a lon dimension.

    Parameters
    ----------
    model_da : xr.DataArray  shape (member, lon)
    obs_lo   : xr.DataArray  obs lower bound, with lon coord (any lat dim is averaged first)
    obs_hi   : xr.DataArray  obs upper bound

    Returns
    -------
    xr.DataArray  shape (member,)
    """
    if 'lat' in obs_lo.dims:
        obs_lo = obs_lo.mean('lat')
    if 'lat' in obs_hi.dims:
        obs_hi = obs_hi.mean('lat')

    model_lons = model_da['lon'].values
    obs_lo_interp = obs_lo.interp(lon=model_lons, method='nearest')
    obs_hi_interp = obs_hi.interp(lon=model_lons, method='nearest')

    per_lon = _penalty_elementwise(model_da, obs_lo_interp, obs_hi_interp)
    return per_lon.sum('lon', skipna=True, min_count=1)


def _obs_to_scalar(obs_lo, obs_hi, vars_dict):
    """
    Reduce obs bounds to scalars by applying the lat/lon subsetting from the
    metric's vars_dict, then computing a lat-weighted (and lon-averaged) mean.

    Returns (lo_scalar, hi_scalar) as Python floats.
    """
    lo = obs_lo
    hi = obs_hi

    # Extract lat/lon selections from the first variable entry in vars_dict
    lat_sel = None
    lon_sel = None
    for _, sel in vars_dict.items():
        if sel:
            lat_sel = sel.get('lat', None)
            lon_sel = sel.get('lon', None)
        break

    # Apply selections
    if lat_sel is not None and 'lat' in lo.dims:
        try:
            lo = lo.sel(lat=lat_sel)
            hi = hi.sel(lat=lat_sel)
        except Exception:
            pass
    if lon_sel is not None and 'lon' in lo.dims:
        try:
            lo = lo.sel(lon=lon_sel)
            hi = hi.sel(lon=lon_sel)
        except Exception:
            pass

    # Compute weighted mean
    if 'lat' in lo.dims:
        lat_weights = np.cos(np.deg2rad(lo['lat']))
        dims_to_mean = [d for d in ('lat', 'lon') if d in lo.dims]
        lo_scalar = float(lo.weighted(lat_weights).mean(dims_to_mean).item())
        hi_scalar = float(hi.weighted(lat_weights).mean(dims_to_mean).item())
    elif 'lon' in lo.dims:
        lo_scalar = float(lo.mean('lon').item())
        hi_scalar = float(hi.mean('lon').item())
    else:
        lo_scalar = float(lo.item())
        hi_scalar = float(hi.item())

    return lo_scalar, hi_scalar


